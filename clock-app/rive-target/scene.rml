            <Fill name="Fill"><SolidColor colorValue="99A989E0" name="Color"/></Fill>
        </Shape>

        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="0:12"/>
                </EntryState>
                <AnimationState x="200" animationId="0:6" id="0:12"/>
            </StateMachineLayer>
        </StateMachine>

        <!-- 2.4s loop: fly in (0-16), hit and wobble (16-56), hold, fade out (108-124), empty beat -->
        <LinearAnimation loopValue="loop" duration="144" name="Hit Loop" id="0:6">
            <KeyedObject objectId="0:30">
                <KeyedProperty property="x">
                    <KeyFrameDouble value="160" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.5" y1="0" x2="0.9" y2="0.6"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="16" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="y">
                    <KeyFrameDouble value="-160" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.5" y1="0" x2="0.9" y2="0.6"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="16" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="-0.7853982" frame="16" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.5" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.62" frame="21" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.92" frame="28" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.70" frame="35" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.84" frame="42" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.76" frame="49" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.7853982" frame="56" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="1" frame="0" interpolationType="hold"/>
                    <KeyFrameDouble value="1" frame="108" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="1" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="124" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>

            <KeyedObject objectId="0:20">
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" frame="16" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.93" frame="20" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.04" frame="28" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="38" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="16" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.93" frame="20" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.04" frame="28" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="38" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>

            <KeyedObject objectId="0:35">
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="0.4" frame="16" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="3" frame="40" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="0.4" frame="16" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="3" frame="40" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="0" frame="0" interpolationType="hold"/>
                    <KeyFrameDouble value="0.9" frame="16" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="40" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- Sparkles pop on the hit, staggered, and settle back small -->
            <KeyedObject objectId="0:40">
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="0.5" frame="18" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.4" y2="1.6"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="32" interpolationType="hold"/>
                    <KeyFrameDouble value="1" frame="100" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.5" frame="124" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="0.5" frame="18" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.4" y2="1.6"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="32" interpolationType="hold"/>
                    <KeyFrameDouble value="1" frame="100" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.5" frame="124" interpolationType="hold"/>
