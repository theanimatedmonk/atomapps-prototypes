<Rive version="1" kind="fragment">
    <!-- Wake-up challenge icon: an arrow flies in, sticks in the bullseye and wobbles, then fades and loops. -->
    <Artboard defaultStateMachineId="0:7" styleId="0:5" width="240" height="240" name="Target" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- Sparkles (declared first so they draw on top) -->
        <Shape x="38" y="42" name="Sparkle A" id="0:40">
            <Star width="30" height="30" points="4" innerRadius="0.32" cornerRadius="1.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FFF0679A" name="Color"/></Fill>
        </Shape>
        <Shape x="20" y="76" name="Sparkle B" id="0:41">
            <Star width="18" height="18" points="4" innerRadius="0.32" cornerRadius="1" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FFF58BB2" name="Color"/></Fill>
        </Shape>
        <Shape x="210" y="186" name="Sparkle C" id="0:42">
            <Star width="28" height="28" points="4" innerRadius="0.32" cornerRadius="1.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FFF0679A" name="Color"/></Fill>
        </Shape>
        <Shape x="226" y="156" name="Sparkle D" id="0:43">
            <Star width="16" height="16" points="4" innerRadius="0.32" cornerRadius="1" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FFF58BB2" name="Color"/></Fill>
        </Shape>

        <!-- Board: the face and rim, pivoting at the bullseye so the hit squashes from the centre -->
        <Node x="118" y="102" name="Board" id="0:20">
            <!-- Arrow: origin is the tip, the tail runs along +x and the group is turned up-right -->
            <Node x="0" y="0" rotation="-0.7853982" name="Arrow" id="0:30">
                <Shape x="88" y="0" name="Fletching Top">
                    <PointsPath isClosed="true" isClockwise="true" name="Path">
                        <StraightVertex x="10" y="-26" radius="4"/>
                        <StraightVertex x="34" y="-26" radius="4"/>
                        <StraightVertex x="26" y="-3" radius="2"/>
                        <StraightVertex x="-4" y="-3" radius="2"/>
                    </PointsPath>
                    <Fill name="Fill">
                        <LinearGradient startX="10" startY="-26" endX="10" endY="-3" name="Gradient">
                            <GradientStop colorValue="FFFFDCA0" position="0"/>
                            <GradientStop colorValue="FFF5A04A" position="1"/>
                        </LinearGradient>
                    </Fill>
                </Shape>
                <Shape x="88" y="0" name="Fletching Bottom">
                    <PointsPath isClosed="true" isClockwise="true" name="Path">
                        <StraightVertex x="-4" y="3" radius="2"/>
                        <StraightVertex x="26" y="3" radius="2"/>
                        <StraightVertex x="34" y="26" radius="4"/>
                        <StraightVertex x="10" y="26" radius="4"/>
                    </PointsPath>
                    <Fill name="Fill">
                        <LinearGradient startX="10" startY="3" endX="10" endY="26" name="Gradient">
                            <GradientStop colorValue="FFF5A04A" position="0"/>
                            <GradientStop colorValue="FFE07F2A" position="1"/>
                        </LinearGradient>
                    </Fill>
                </Shape>
                <Shape x="4" y="0" name="Shaft">
                    <Rectangle originX="0" originY="0.5" width="122" height="10" cornerRadiusTL="5" name="Path"/>
                    <Fill name="Fill">
                        <LinearGradient startX="0" startY="-5" endX="0" endY="5" name="Gradient">
                            <GradientStop colorValue="FF3A5FA0" position="0"/>
                            <GradientStop colorValue="FF1E3560" position="1"/>
                        </LinearGradient>
                    </Fill>
                </Shape>
            </Node>

            <!-- Impact ripple -->
            <Shape opacity="0" name="Ripple" id="0:35">
                <Ellipse width="44" height="44" name="Path"/>
                <Stroke thickness="5" name="Stroke"><SolidColor colorValue="FFFFFFFF" name="Color"/></Stroke>
            </Shape>

            <!-- Face, inner ring first -->
            <Shape x="-18" y="-20" name="Sheen">
                <Ellipse width="100" height="100" name="Path"/>
                <Fill name="Fill">
                    <RadialGradient startX="0" startY="0" endX="50" endY="0" name="Gradient">
                        <GradientStop colorValue="66FFFFFF" position="0"/>
                        <GradientStop colorValue="00FFFFFF" position="1"/>
                    </RadialGradient>
                </Fill>
            </Shape>
            <Shape name="Bull">
                <Ellipse width="30" height="30" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFE33D6E" name="Color"/></Fill>
            </Shape>
            <Shape name="Ring White Inner">
                <Ellipse width="58" height="58" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFFF5F8" name="Color"/></Fill>
            </Shape>
            <Shape name="Ring Pink Inner">
                <Ellipse width="88" height="88" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFF2678F" name="Color"/></Fill>
            </Shape>
            <Shape name="Ring White Outer">
                <Ellipse width="118" height="118" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="Color"/></Fill>
            </Shape>
            <Shape name="Ring Pink Outer">
                <Ellipse width="150" height="150" name="Path"/>
                <Fill name="Fill">
                    <LinearGradient startX="-40" startY="-75" endX="40" endY="75" name="Gradient">
                        <GradientStop colorValue="FFFFA6C1" position="0"/>
                        <GradientStop colorValue="FFE04477" position="1"/>
                    </LinearGradient>
                </Fill>
            </Shape>
            <!-- Rim, offset left so the board reads as a thick disc -->
            <Shape x="-10" y="3" name="Rim">
                <Ellipse width="170" height="170" name="Path"/>
                <Fill name="Fill">
                    <LinearGradient startX="-60" startY="-80" endX="40" endY="80" name="Gradient">
                        <GradientStop colorValue="FF4A6FB0" position="0"/>
                        <GradientStop colorValue="FF1E3354" position="1"/>
                    </LinearGradient>
                </Fill>
            </Shape>
        </Node>

        <!-- Stand -->
        <Shape x="114" y="16" name="Knob">
            <Rectangle width="22" height="22" cornerRadiusTL="7" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF2C4A80" name="Color"/></Fill>
        </Shape>
        <Shape x="118" y="186" name="Leg Middle">
            <Rectangle width="16" height="48" cornerRadiusTL="8" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF22396A" name="Color"/></Fill>
