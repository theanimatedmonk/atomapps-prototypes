                    <KeyFrameDouble value="1" frame="36" interpolationType="hold"/>
                    <KeyFrameDouble value="1" frame="104" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
